# LMS Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<db_username>:<db_password>@lms.3xf7acg.mongodb.net/LMS?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@lms.3xf7acg.mongodb.net/LMS?retryWrites=true&w=majority

# JWT Authentication Secrets
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# Frontend Client URL for CORS
FRONTEND_URL=http://localhost:5173

# Initial Administrator Provisioning (Optional defaults for setupAdmin.js)
INIT_ADMIN_NAME=Principal Administrator
INIT_ADMIN_EMAIL=admin@college.edu
INIT_ADMIN_PASSWORD=
